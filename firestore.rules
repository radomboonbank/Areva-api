rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'radomboon.t@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /crod/database {
      allow get: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['rowsJson', 'revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.rowsJson is string
        && request.resource.data.rowsJson.size() <= 700000
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
  }
}
