rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner-approved shared editing: no sign-in is required.
    match /crod/database {
      allow get: if true;
      allow update: if request.resource.data.keys().hasOnly(['rowsJson', 'revision', 'updatedAt'])
        && request.resource.data.rowsJson is string
        && request.resource.data.rowsJson.size() <= 700000
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
    }
  }
}
